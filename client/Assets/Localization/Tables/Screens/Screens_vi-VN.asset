  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Screens_vi-VN
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: 7b48aa66445f7e745ceaee85ebd44e5c, type: 2}
  m_Metadata:
    m_Items:
    - rid: 3000000000000000000
    - rid: 3000000000000000002
  m_TableData:
  - m_Id: 3100000000
    m_Localized: "\u0110ang ki\u1EC3m tra phi\u00EAn b\u1EA3n..."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000001
    m_Localized: "\u0110ang c\u1EADp nh\u1EADt t\u00E0i nguy\u00EAn"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000002
    m_Localized: "\u0110\u0103ng nh\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000003
    m_Localized: "\u0110\u0103ng k\u00FD"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000004
    m_Localized: "Ho\u1EB7c \u0111\u0103ng nh\u1EADp b\u1EB1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000005
    m_Localized: "T\u00EAn \u0111\u0103ng nh\u1EADp ho\u1EB7c m\u1EADt kh\u1EA9u kh\u00F4ng \u0111\u00FAng."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000006
    m_Localized: "C\u1EA7n c\u1EADp nh\u1EADt b\u1EA3n m\u1EDBi \u0111\u1EC3 ti\u1EBFp t\u1EE5c."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000007
    m_Localized: "M\u00E1y ch\u1EE7 \u0111ang b\u1EADn, vui l\u00F2ng th\u1EED l\u1EA1i sau."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000008
    m_Localized: "T\u00E0i kho\u1EA3n \u0111ang b\u1ECB kh\u00F3a."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000009
    m_Localized: "T\u00EAn \u0111\u0103ng nh\u1EADp \u0111\u00E3 \u0111\u01B0\u1EE3c s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000010
    m_Localized: "Email \u0111\u00E3 \u0111\u01B0\u1EE3c s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000011
    m_Localized: "T\u00EAn \u0111\u0103ng nh\u1EADp kh\u00F4ng h\u1EE3p l\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000012
    m_Localized: "Email kh\u00F4ng h\u1EE3p l\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000013
    m_Localized: "M\u1EADt kh\u1EA9u kh\u00F4ng h\u1EE3p l\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000014
    m_Localized: "\u0110ang v\u00E0o h\u00E0ng ch\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000015
    m_Localized: "V\u1ECB tr\u00ED c\u1EE7a b\u1EA1n: {position}"
    m_Metadata:
      m_Items:
      - rid: 3000000000000000000
  - m_Id: 3100000016
    m_Localized: "\u0110ang t\u1EF1 \u0111\u1ED9ng th\u1EED l\u1EA1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000017
    m_Localized: "H\u1EE7y"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000018
    m_Localized: "Ch\u1ECDn nh\u00E2n v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000019
    m_Localized: "T\u1EA1o nh\u00E2n v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000020
    m_Localized: "\u0110\u0103ng xu\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000021
    m_Localized: "Ch\u01B0a c\u00F3 nh\u00E2n v\u1EADt n\u00E0o"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000022
    m_Localized: "\u0110ang chuy\u1EC3n v\u00F9ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000023
    m_Localized: "\u0110ang ch\u1EDD ch\u1ED7 trong khu v\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000024
    m_Localized: "Chuy\u1EC3n v\u00F9ng th\u1EA5t b\u1EA1i, \u0111ang quay l\u1EA1i \u0111i\u1EC3m an to\u00E0n"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000025
    m_Localized: "C\u00E0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000026
    m_Localized: "Ch\u1EA5t l\u01B0\u1EE3ng \u0111\u1ED3 h\u1ECDa"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000027
    m_Localized: "Ti\u1EBFt ki\u1EC7m pin (30 FPS)"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000028
    m_Localized: "Ng\u00F4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000029
    m_Localized: "T\u00EDn d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000030
    m_Localized: "Kh\u00F4ng t\u1EA3i \u0111\u01B0\u1EE3c n\u1ED9i dung t\u00EDn d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000031
    m_Localized: "M\u1EA5t k\u1EBFt n\u1ED1i t\u1EDBi m\u00E1y ch\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000032
    m_Localized: "\u0110ang th\u1EED k\u1EBFt n\u1ED1i l\u1EA1i... (L\u1EA7n {attempt}/{max})"
    m_Metadata:
      m_Items:
      - rid: 3000000000000000002
  - m_Id: 3100000033
    m_Localized: "Tho\u00E1t ra m\u00E0n h\u00ECnh ch\u00EDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 3100000034
    m_Localized: "T\u00E0i kho\u1EA3n c\u1EE7a b\u1EA1n \u0111\u00E3 \u0111\u01B0\u1EE3c \u0111\u0103ng nh\u1EADp t\u1EEB m\u1ED9t thi\u1EBFt b\u1ECB kh\u00E1c."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000035
    m_Localized: "\u0110\u1ED3ng \u00FD"
    m_Metadata:
      m_Items: []
